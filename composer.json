{
    "name": "team-blue/php-json-immutable-objects",
    "type": "library",
    "description": "Immutable objects with a json schema",
    "homepage": "https://gitlab.group.team.blue/be-platforms/packages/php/json-immutable-objects",
    "license": "MIT",
    "authors": [
        {
            "name": "Arne De Smedt",
            "email": "arnedesmdt@gmail.com",
            "homepage": "https://github.com/arnedesmedt"
        }
    ],
    "require": {
        "php": "^8.0 || ^8.1 || ^8.2 || ^8.3",
        "ext-sodium": "*",
        "ext-mbstring": "*",
        "event-engine/php-json-schema": "~3.0",
        "phpdocumentor/reflection-docblock": "~5.0",
        "symfony/yaml": "~6.0 || ~7.0",
        "symfony/http-kernel": "~6.0 || ~7.0"
    },
    "require-dev" : {
        "doctrine/coding-standard": "~12.0",
        "phpmd/phpmd": "~2.0",
        "phpro/grumphp": "~2.0",
        "phpstan/phpstan": "~1.0",
        "phpunit/phpunit": "~11.0",
        "rector/rector": "~1.0",
        "squizlabs/php_codesniffer": "~3.0",
        "team-blue/php-value-objects": "^0.5.2"
    },
    "repositories": {
        "packeton.teamblue-ops.net": {
            "type": "composer",
            "url": "https://packeton.teamblue-ops.net"
        }
    },
    "autoload": {
        "psr-4": {
            "TeamBlue\\JsonImmutableObjects\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TeamBlue\\JsonImmutableObjects\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpro/grumphp": true
        },
        "sort-packages": true
    },
    "scripts-descriptions": {
        "tests": "Run all tests"
    },
    "scripts": {
        "tests": [
            "vendor/bin/phpcs",
            "vendor/bin/phpstan analyze --no-progress",
            "vendor/bin/phpmd src text phpmd.xml",
            "vendor/bin/phpmd tests text phpmd-tests.xml",
            "vendor/bin/rector --dry-run --no-progress-bar",
            "vendor/bin/phpunit"
        ]
    },
    "bin": [
        "bin/team-blue-jio-encrypt-decrypt.php"
    ]
}
